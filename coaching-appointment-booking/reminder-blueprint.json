{
  "name": "Rappel séance coaching 24h",
  "metadata": {
    "instant": false,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": false,
      "sequential": false,
      "confidential": false,
      "dataloss": false,
      "dlq": false,
      "freshVariables": false
    }
  },
  "flow": [
    {
      "id": 1,
      "module": "google-sheets:filterRows",
      "version": 2,
      "parameters": { "__IMTCONN__": 0 },
      "mapper": {
        "from": "drive",
        "spreadsheetId": "YOUR_SPREADSHEET_ID",
        "sheetId": "Suivi de rendez-vous",
        "includesHeaders": true,
        "tableFirstRow": "A1:Z1",
        "valueRenderOption": "FORMATTED_VALUE",
        "dateTimeRenderOption": "FORMATTED_STRING",
        "filter": [
          [
            { "a": "I", "o": "text:equal", "b": "Confirmé" },
            { "a": "D", "o": "text:equal", "b": "{{formatDate(addDays(now; 1); \"YYYY-MM-DD\"; \"Europe/Paris\")}}" }
          ]
        ]
      }
    },
    {
      "id": 2,
      "module": "google-email:sendAnEmail",
      "version": 4,
      "parameters": { "__IMTCONN__": 0 },
      "mapper": {
        "to": ["{{1.`1`}}"],
        "subject": "Rappel : votre séance de coaching demain à {{1.`4`}}",
        "bodyType": "rawHtml",
        "content": "<p>Bonjour {{1.`0`}},</p><p>Un petit rappel : votre séance de coaching a lieu <b>demain à {{1.`4`}}</b> ({{1.`5`}} minutes).</p><p><b>Objectif de la séance :</b> {{1.`6`}}</p><p>Si vous avez un empêchement, répondez simplement à cet e-mail pour la déplacer ou l'annuler.</p><p>À demain !</p>"
      }
    },
    {
      "id": 3,
      "module": "google-sheets:updateRow",
      "version": 2,
      "parameters": { "__IMTCONN__": 0 },
      "mapper": {
        "mode": "select",
        "from": "drive",
        "spreadsheetId": "YOUR_SPREADSHEET_ID",
        "sheetId": "Suivi de rendez-vous",
        "rowNumber": "{{1.__ROW_NUMBER__}}",
        "includesHeaders": true,
        "useColumnHeaders": false,
        "valueInputOption": "RAW",
        "values": { "8": "Rappel envoyé" }
      }
    }
  ]
}
